{
  "name": "pdfwright-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --check && pnpm run check:type-aware-coverage && pnpm test && pnpm run test:bun && pnpm run test:deno && pnpm run build",
    "lint": "status=0; oxlint --fix --fix-suggestions --fix-dangerously || status=1; oxfmt || status=1; pnpm run check:type-aware-coverage || status=1; exit \"$status\"",
    "test": "vitest run",
    "test:bun": "bun --bun node_modules/vitest/vitest.mjs run --project bun",
    "test:deno": "deno run -A node_modules/vitest/vitest.mjs run --project deno",
    "build": "pnpm --recursive --filter=./packages/* run build",
    "check:type-aware-coverage": "node scripts/assertTypeAwareCoverage.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.10",
    "@oxlint/plugins": "1.90.0",
    "@types/node": "26.6.6",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "bun": "npm:bun@1.4.4",
    "deno": "npm:deno@2.9.6",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pako": "3.0.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
